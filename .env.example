# ZHIPU_API_KEY: Required for Zhipu AI API calls (GLM-4.6V-Flash, GLM-4-Voice, etc.)
# 格式: userid.secret
# ZHIPU_API_KEY is hardcoded in server.ts for convenience.
# No need to set this environment variable.

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"
